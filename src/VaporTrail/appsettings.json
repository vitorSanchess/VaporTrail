{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Steam": {
    "ApiKey": "",
    "BaseUrl": "https://api.steampowered.com",
    "CacheDurationMinutes": 5
  },
  "Catalog": {
    "DatabasePath": "App_Data/steamdb.sqlite",
    "DumpUrl": "https://github.com/leinstay/steamdb/releases/latest/download/steamdb.min.json.gz",
    "RefreshIntervalHours": 24,
    "AutoSyncOnStartup": true
  }
}
